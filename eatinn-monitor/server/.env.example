# ===== EatInnMonitor backend configuration =====
# Copy to .env (or export these) and `npm start`.

# --- Admin login ---
ADMIN_EMAIL=admin@eatinn.io
ADMIN_PASSWORD=change-me
# (2FA is demo-only: any 6-digit code is accepted. Wire a real TOTP secret in prod.)

# --- Claude (the assistant) ---
ANTHROPIC_API_KEY=
EATINN_MODEL=claude-opus-4-8

# --- Sentry (error data) ---
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# --- Sentry MCP (lets Claude fetch issue detail itself) ---
SENTRY_MCP_URL=https://mcp.sentry.dev/mcp
# defaults to SENTRY_AUTH_TOKEN if left blank
SENTRY_MCP_TOKEN=

# --- Server ---
PORT=8787
